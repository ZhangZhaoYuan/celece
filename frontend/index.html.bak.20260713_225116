let _modelList = [];
let _defaultIds = { chat: '', vision: '', imagegen: '', embedding: '' };

async function loadModelConfigTab() {
  try {
    const r = await api('GET', '/api/models');
    _modelList = r.models || [];
    _defaultIds = r.default_ids || { chat: '', vision: '', imagegen: '', embedding: '' };
    // 判断模型分类（优先 categories 字段）
        function getCat(m) {
          const cats = m.categories;
          if (cats && cats.length > 0) {
            if (cats.includes('vision')) return 'vision';
            if (cats.includes('imagegen')) return 'imagegen';
            if (cats.includes('embedding')) return 'embedding';
            if (cats.includes('chat')) return 'chat';
          }
          if (m.id === _defaultIds.vision) return 'vision';
          if (m.id === _defaultIds.imagegen) return 'imagegen';
          if (m.id === _defaultIds.embedding) return 'embedding';
          const n = (m.model || '').toLowerCase(), id = (m.id || '').toLowerCase();
          if (n.includes('embedding') || id.includes('embedding')) return 'embedding';
          if (n.includes('v-flash') || n.includes('4v') || n.includes('vision') || n.includes('omni-turbo')) return 'vision';
          if (n.includes('cogview') || n.includes('image') || id.includes('image_gen') || id.includes('imagegen')) return 'imagegen';
          return 'chat';
        }
    const selects = [
      { id: 'selChatModel', type: 'chat' },
      { id: 'selImageGenModel', type: 'imagegen' },
      { id: 'selVisionModel', type: 'vision' },
      { id: 'selEmbeddingModel', type: 'embedding' }
    ];
    for (const s of selects) {
      const sel = document.getElementById(s.id);
      if (!sel) continue;
      const currentId = _defaultIds[s.type] || '';
      const filtered = _modelList.filter(m => getCat(m) === s.type);
      sel.innerHTML = filtered.map(m => {
        const label = m.model + (m.provider ? ' · ' + m.provider : '');
        return '<option value="' + m.id + '"' + (m.id === currentId ? ' selected' : '') + '>' + escapeHtml(label) + '</option>';
      }).join('');
    }
    const infoMap = [
      { type: 'chat', id: 'chatModelInfo' },
      { type: 'imagegen', id: 'imagegenModelInfo' },
      { type: 'vision', id: 'visionModelInfo' },
      { type: 'embedding', id: 'embeddingModelInfo' }
    ];
    for (const info of infoMap) {
      const el = document.getElementById(info.id);
      if (!el) continue;
      const currentId = _defaultIds[info.type] || '';
      const model = _modelList.find(m => m.id === currentId);
      if (model) {
        const base = model.base_url.replace(/^https?:\/\//, '').slice(0, 40);
        el.textContent = '提供商: ' + model.provider + '  ·  端点: ' + base;
      } else {
        el.textContent = '未配置';
      }
    }
    document.getElementById('modelConfigStatus').textContent = '';
  } catch(e) {
    document.getElementById('modelConfigStatus').textContent = '❌ 加载失败: ' + e.message;
  }
}

