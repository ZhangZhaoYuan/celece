<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>小赛助手 </title>
<style>
/* ===== 全局重置 ===== */
*{box-sizing:border-box;margin:0;padding:0}
:root{
  --bg:#f0f2f5;
  --bg-surface:#fff;
  --bg-chat:#efeae2;
  --text:#1a1a1a;
  --text-secondary:#666;
  --border:#e0e0e0;
  --primary:#07c160;
  --primary-hover:#06ad56;
  --accent:#3b82f6;
  --accent-bg:rgba(59,130,246,0.08);
  --card-bg:var(--bg-surface);
  --input-bg:#fff;
  --bg-secondary:#f5f5f5;
  --danger:#e53935;
  --danger-hover:#c62828;
  --shadow:0 2px 12px rgba(0,0,0,.08);
  --radius:8px;
  --radius-lg:12px;
  --sidebar-w:260px;
  --header-h:52px;
  --footer-h:44px;
}
html,body{height:100%;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Noto Sans SC',sans-serif;background:var(--bg);color:var(--text);font-size:14px;overflow:hidden}

/* ===== 布局 ===== */
.app{display:flex;flex-direction:column;height:100vh}
.header{height:var(--header-h);background:var(--bg-surface);border-bottom:1px solid var(--border);display:flex;align-items:center;padding:0 16px;gap:8px;flex-shrink:0}
.header-left{display:flex;align-items:center;gap:12px;font-weight:600;font-size:16px}
.header-left small{font-weight:400;font-size:11px;color:var(--text-secondary);margin-left:4px}
.header-center{flex:1;display:flex;justify-content:center;gap:8px}
.header-right{display:flex;align-items:center;gap:8px}
.body{flex:1;display:flex;overflow:hidden}
.sidebar{width:var(--sidebar-w);background:var(--bg-surface);border-right:1px solid var(--border);display:flex;flex-direction:column;flex-shrink:0}
.sidebar-search{padding:10px 12px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:8px}
.sidebar-search input{flex:1;padding:8px 12px;border:1px solid var(--border);border-radius:20px;font-size:13px;outline:none;transition:border .2s}
.sidebar-search input:focus{border-color:var(--primary)}
.sidebar-search .add-btn{width:32px;height:32px;border-radius:50%;border:none;background:transparent;cursor:pointer;font-size:20px;display:flex;align-items:center;justify-content:center;flex-shrink:0;color:var(--text);transition:background .15s;line-height:1}
.sidebar-search .add-btn:hover{background:#f0f0f0}
.sidebar-list{flex:1;overflow-y:auto}
.sidebar-item{padding:10px 14px;border-bottom:1px solid #f0f0f0;cursor:pointer;display:flex;flex-direction:column;gap:2px;transition:background .15s}
.sidebar-item:hover{background:#f5f5f5}
.sidebar-item.active{background:#d4edda;border-left:3px solid var(--primary);font-weight:600}
.sidebar-item .top-row{display:flex;align-items:center;justify-content:space-between;gap:4px}
.sidebar-item .name{font-weight:500;font-size:14px;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sidebar-item .customer-actions{display:flex;gap:4px;opacity:0;transition:opacity .15s}
.sidebar-item:hover .customer-actions{opacity:1}
.sidebar-item .customer-actions button{border:none;background:transparent;cursor:pointer;font-size:13px;padding:2px;border-radius:4px;line-height:1;color:var(--text-secondary);transition:color .15s}
.sidebar-item .customer-actions button:hover{color:var(--primary)}
.sidebar-item .customer-actions .del-icon:hover{color:var(--danger)}
.sidebar-item .preview{font-size:12px;color:var(--text-secondary);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:220px}
/* ===== 客户分类折叠列表 ===== */
.category-group{border-bottom:1px solid #f0f0f0}
.category-header{display:flex;align-items:center;gap:6px;padding:10px 12px;cursor:pointer;font-size:13px;font-weight:500;transition:background .15s;user-select:none}
.category-header:hover{background:#f5f5f5}
.category-header .arrow{font-size:10px;color:#999;transition:transform .2s;width:14px;flex-shrink:0;text-align:center}
.category-header .arrow.expanded{transform:rotate(90deg)}
.category-header .cat-label{flex:1}
.category-header .cat-count{font-size:11px;color:var(--text-secondary);background:#f0f0f0;padding:1px 8px;border-radius:10px}
.category-body{overflow:hidden;max-height:0;transition:max-height .3s ease}
.category-body.expanded{max-height:2000px}
.category-body .sidebar-item{padding-left:22px}
.main-area{flex:1;display:flex;flex-direction:column;position:relative;min-height:0}
.chat-wrapper{flex:1;display:flex;flex-direction:column;min-height:0}
.footer{height:var(--footer-h);background:var(--bg-surface);border-top:1px solid var(--border);display:flex;align-items:center;padding:0 16px;justify-content:flex-end;flex-shrink:0;position:relative;z-index:10}

/* ===== 聊天区域 ===== */
.chat-container{flex:1;overflow-y:auto;padding:16px;background:var(--bg-chat);display:flex;flex-direction:column;gap:10px;min-height:0}
.chat-empty{flex:1;display:flex;align-items:center;justify-content:center;color:var(--text-secondary);font-size:15px;text-align:center;flex-direction:column;gap:8px}
.chat-empty .icon{font-size:48px;opacity:.3}
.chat-msg{max-width:75%;padding:8px 14px;border-radius:12px;line-height:1.6;word-break:break-word;position:relative;font-size:14px;background:transparent}
.chat-msg.ai{align-self:flex-start;border-bottom-left-radius:4px;box-shadow:0 1px 2px rgba(0,0,0,.08);background:#fff}
.chat-msg.user{align-self:flex-end}
.chat-msg .time{font-size:10px;color:var(--text-secondary);margin-top:4px;opacity:.7}
.chat-msg.user .time{text-align:right}
.chat-msg .msg-content{white-space:pre-wrap;overflow:hidden;transition:max-height .3s}
.chat-msg .msg-content.collapsed{max-height:7.5em;overflow:hidden;position:relative}
.chat-msg .msg-content.collapsed::after{content:'...';position:absolute;bottom:0;right:4px;background:inherit;padding:0 4px;color:var(--text-secondary);font-weight:700}
.chat-msg .msg-actions{display:flex;gap:4px;margin-top:6px;opacity:0;transition:opacity .2s;width:fit-content;align-items:center}
.chat-msg:hover .msg-actions{opacity:1}
.chat-msg .msg-actions button{border:none;background:rgba(0,0,0,.04);cursor:pointer;font-size:11px!important;padding:3px 10px;border-radius:6px;color:var(--text-secondary);white-space:nowrap;line-height:1.5;transition:all .15s}
.chat-msg .msg-actions button:hover{background:rgba(0,0,0,.1);color:#333}
.chat-msg .msg-actions .del-btn:hover{color:var(--danger);background:rgba(229,57,53,.08)}
/* ===== 标签芯片 ===== */
.tag-chip{display:inline-flex;align-items:center;gap:4px;padding:4px 14px;background:#e8e8e8;border-radius:14px;font-size:12px;cursor:pointer;transition:all .2s;user-select:none;border:1px solid transparent}
.tag-chip:hover{background:#ddd}
.tag-chip.active{background:#07c160;color:#fff;border-color:#06ad56}

/* ===== 聊天输入区域 ===== */
.chat-input-area{background:var(--bg-surface);border-top:1px solid var(--border);padding:10px 16px;display:flex;gap:8px;align-items:flex-end}
.chat-input-editable{flex:1;min-height:44px;max-height:50vh;overflow-y:auto;padding:10px 16px;font-size:14px;line-height:1.5;font-family:inherit;outline:none;border:1px solid var(--border);border-radius:20px;transition:border .2s;white-space:pre-wrap;word-break:break-word;color:var(--text);background:transparent}
.chat-input-editable:focus{border-color:var(--primary)}
.chat-input-editable:empty::before{content:attr(data-placeholder);color:#999;pointer-events:none}
.input-tag{color:#1890ff;cursor:pointer;white-space:nowrap;padding:0 1px;border-radius:2px;user-select:text}
.input-tag:hover{background:rgba(24,144,255,0.1)}
.chat-input-area .send-btn{width:44px;height:44px;border-radius:50%;border:none;background:var(--primary);color:#fff;font-size:20px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:background .2s;flex-shrink:0}
.chat-input-area .send-btn:hover{background:var(--primary-hover)}
.chat-input-area .send-btn:disabled{background:#ccc;cursor:not-allowed}
.chat-input-area .img-btn{width:44px;height:44px;border-radius:50%;border:1px dashed var(--border);background:transparent;color:var(--text-secondary);font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .2s;flex-shrink:0}
.chat-input-area .img-btn:hover{border-color:var(--primary);color:var(--primary);background:rgba(99,102,241,.06)}
.chat-input-area .img-btn:disabled{opacity:.4;cursor:not-allowed}
#imagePreviewArea{display:flex;gap:8px;padding:8px 16px 0;flex-wrap:wrap;align-items:center}
#imagePreviewArea .preview-item{position:relative;width:60px;height:60px;border-radius:8px;overflow:hidden;border:1px solid var(--border);background:var(--bg-surface)}
#imagePreviewArea .preview-item img{width:100%;height:100%;object-fit:cover}
#imagePreviewArea .preview-item .loading-overlay{position:absolute;inset:0;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;color:#fff;font-size:10px;border-radius:8px}
#imagePreviewArea .preview-item .loading-overlay .spinner{width:16px;height:16px;border:2px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:spin .6s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}
#imagePreviewArea .preview-item .remove-btn{position:absolute;top:-4px;right:-4px;width:18px;height:18px;border-radius:50%;border:none;background:var(--danger);color:#fff;font-size:10px;cursor:pointer;display:flex;align-items:center;justify-content:center;box-shadow:0 1px 3px rgba(0,0,0,.2);line-height:1}
#imagePreviewArea .preview-item .fail-overlay{position:absolute;inset:0;background:rgba(0,0,0,.5);display:flex;align-items:center;justify-content:center;color:#ff5252;font-size:22px;border-radius:8px;font-weight:700}

/* ===== 加载动画（三点抖动） ===== */
.thinking-dots{display:flex;align-items:center;gap:5px;padding:12px 0 4px}
.think-dot{width:8px;height:8px;border-radius:50%;background:#999;animation:thinkBounce 1.4s infinite ease-in-out both}
.think-dot:nth-child(1){animation-delay:0s}
.think-dot:nth-child(2){animation-delay:.16s}
.think-dot:nth-child(3){animation-delay:.32s}
.thinking-dots .hint{margin-left:8px;font-size:13px;color:#999}
@keyframes thinkBounce{0%,80%,100%{transform:scale(0)}40%{transform:scale(1)}}

/* ===== AI话术代码块 ===== */
.script-bubble{padding:4px 0;width:100%;transition:max-height .3s}
.script-bubble.collapsed{max-height:170px;overflow:hidden;position:relative}
.script-bubble.collapsed::after{content:'';position:absolute;bottom:0;left:0;right:0;height:40px;background:linear-gradient(transparent,var(--bg-chat));pointer-events:none}
.script-block{border:1px solid #e6e6e6;border-radius:6px;margin-bottom:10px;overflow:hidden;background:transparent}
.script-block:last-child{margin-bottom:0}
.script-block-header{display:flex;justify-content:flex-end;align-items:center;padding:3px 8px;background:#f5f5f5;border-bottom:1px solid #e6e6e6}
.script-block-header .cp-btn{background:transparent;border:none;cursor:pointer;font-size:13px;color:#999;padding:3px 7px;border-radius:4px;transition:all .15s;line-height:1}
.script-block-header .cp-btn:hover{background:#e8e8e8;color:#333}
.script-block-content{padding:10px 14px;color:#1a1a1a;font-size:13px;line-height:1.7;white-space:pre-wrap;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Noto Sans SC',sans-serif;background:#fff;overflow-x:auto}

/* ===== 生成图片卡片 ===== */
.generated-image-card{border:1px solid #e6e6e6;border-radius:6px;margin-bottom:10px;overflow:hidden;background:#fff}
.generated-image-card:last-child{margin-bottom:0}
.generated-image-content{padding:12px;text-align:center;background:#fafafa}
.generated-image-content img{display:block;margin:0 auto;max-width:100%;border-radius:4px;box-shadow:0 1px 4px rgba(0,0,0,.08)}
.generated-image-desc{margin-top:8px;font-size:12px;color:#888;line-height:1.4}
.similar-images-section{margin-top:8px;padding-top:8px;border-top:1px solid #eee}
.similar-img-thumb{transition:transform .15s}
.similar-img-thumb:hover{transform:scale(1.08);box-shadow:0 2px 8px rgba(0,0,0,.12)}
.gen-replace-btn{background:transparent;border:1px solid #ddd;cursor:pointer;font-size:11px;color:#999;padding:2px 8px;border-radius:4px;transition:all .15s;line-height:1.4}
.gen-replace-btn:hover{background:#fff3e0;border-color:#ff9800;color:#e65100}
/* 图片生成进度条 */
.gen-progress-card{border:1px solid var(--border);border-radius:8px;padding:12px;margin:8px 0;background:var(--bg-surface)}
.gen-progress-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;gap:8px}
.gen-progress-header .desc{font-size:13px;color:var(--text);flex:1;min-width:0}
.gen-progress-bar{height:6px;background:#e8e8e8;border-radius:3px;overflow:hidden}
.gen-progress-bar .fill{height:100%;background:linear-gradient(90deg,#4caf50,#8bc34a);border-radius:3px;transition:width .5s ease}
.gen-cancel-btn{font-size:11px;padding:2px 10px;border:1px solid #ddd;border-radius:4px;background:#fff;cursor:pointer;color:#999;white-space:nowrap}
.gen-cancel-btn:hover{border-color:#f44336;color:#f44336;background:#fff5f5}
.gen-cancel-btn:disabled{background:#f5f5f5;color:#ccc;border-color:#eee;cursor:default}
.gen-prompt-box{font-size:12px;color:var(--text-secondary);background:#f5f5f5;border-radius:6px;padding:8px 10px;margin-top:6px;line-height:1.5;word-break:break-word}
/* 图片生成进度条 */
.gen-progress-card{border:1px solid var(--border);border-radius:8px;padding:12px;margin:8px 0;background:var(--bg-surface)}
.gen-progress-header{display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;gap:8px}
.gen-progress-header .desc{font-size:13px;color:var(--text);flex:1;min-width:0}
.gen-progress-bar{height:6px;background:#e8e8e8;border-radius:3px;overflow:hidden}
.gen-progress-bar .fill{height:100%;background:linear-gradient(90deg,#4caf50,#8bc34a);border-radius:3px;transition:width .5s ease}
.gen-cancel-btn{font-size:11px;padding:2px 10px;border:1px solid #ddd;border-radius:4px;background:#fff;cursor:pointer;color:#999;white-space:nowrap}
.gen-cancel-btn:hover{border-color:#f44336;color:#f44336;background:#fff5f5}
.gen-cancel-btn:disabled{background:#f5f5f5;color:#ccc;border-color:#eee;cursor:default}
.gen-prompt-box{font-size:12px;color:var(--text-secondary);background:#f5f5f5;border-radius:6px;padding:8px 10px;margin-top:6px;line-height:1.5;word-break:break-word}

/* ===== 按钮通用 ===== */
.btn{display:inline-flex;align-items:center;gap:4px;padding:8px 16px;border:none;border-radius:20px;cursor:pointer;font-size:13px;font-weight:500;transition:all .2s}
.btn-primary{background:var(--primary);color:#fff}
.btn-primary:hover{background:var(--primary-hover)}
.btn-outline{background:transparent;border:1px solid var(--border);color:var(--text);padding:7px 15px}
.btn-outline:hover{background:#f5f5f5}
.btn-sm{padding:5px 12px;font-size:12px}
.btn-danger{background:var(--danger);color:#fff}
.btn-danger:hover{background:var(--danger-hover)}
.btn-icon{width:36px;height:36px;padding:0;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;background:transparent;border:1px solid var(--border);cursor:pointer;font-size:16px;transition:background .2s}
.btn-icon:hover{background:#f0f0f0}
.btn-icon.active{background:var(--primary);color:#fff;border-color:var(--primary)}

/* ===== 弹窗 ===== */
.modal-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.4);z-index:1000;display:flex;align-items:center;justify-content:center;animation:fadeIn .2s}
.modal-card{background:var(--bg-surface);border-radius:var(--radius-lg);width:520px;max-width:90vw;max-height:80vh;overflow:hidden;box-shadow:0 8px 32px rgba(0,0,0,.15);animation:slideUp .25s;display:flex;flex-direction:column}
.modal-header{display:flex;align-items:center;justify-content:space-between;padding:16px 20px;border-bottom:1px solid var(--border);flex-shrink:0}
.modal-header h3{font-size:16px}
.modal-body{padding:20px;overflow-y:auto;flex:1;scrollbar-width:none;-ms-overflow-style:none}
.modal-body::-webkit-scrollbar{display:none}
.modal-footer{display:flex;gap:8px;justify-content:flex-end;padding:12px 20px;border-top:1px solid var(--border);flex-shrink:0}
.modal-close-btn{width:32px;height:32px;border:none;background:transparent;font-size:18px;cursor:pointer;border-radius:50%;display:flex;align-items:center;justify-content:center}
.modal-close-btn:hover{background:#f0f0f0}
.settings-tabs{display:flex;gap:0;border-bottom:1px solid var(--border);margin-bottom:16px}
.settings-tab{padding:10px 18px;border:none;background:none;cursor:pointer;font-size:13px;color:var(--text-secondary);border-bottom:2px solid transparent;transition:all .2s}
.settings-tab:hover{color:var(--text);background:#f5f5f5}
.settings-tab.active{color:var(--accent);border-bottom-color:var(--accent);font-weight:600}
.settings-tab-content{animation:fadeIn .2s}

/* ===== 小弹窗（右下模型列表） ===== */
.popup-overlay{position:fixed;top:0;left:0;right:0;bottom:0;z-index:999;background:transparent}
.popup-card{position:fixed;bottom:calc(var(--footer-h) + 8px);right:16px;background:var(--bg-surface);border-radius:var(--radius-lg);box-shadow:0 4px 24px rgba(0,0,0,.15);width:320px;max-height:33vh;overflow-y:auto;z-index:1000;animation:fadeIn .15s}
.popup-card .popup-item{padding:10px 16px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #f0f0f0;cursor:pointer;transition:background .15s}
.popup-card .popup-item:hover{background:#f9f9f9}
.popup-card .popup-item .model-info{display:flex;flex-direction:column;gap:2px;flex:1;min-width:0}
.popup-card .popup-item .model-info .name{font-size:13px;font-weight:500}
.popup-card .popup-item .model-info .provider{font-size:11px;color:var(--text-secondary)}
.popup-card .popup-item .badge{font-size:10px;background:var(--primary);color:#fff;padding:2px 8px;border-radius:10px;margin-left:8px;flex-shrink:0}
.popup-card .popup-item .toggle-btn{font-size:12px;border:none;background:transparent;cursor:pointer;color:var(--primary);padding:4px 8px;border-radius:4px;flex-shrink:0}
.popup-card .popup-item .toggle-btn:hover{background:#e8f5e9}
.popup-card .popup-item .delete-btn{font-size:12px;border:none;background:transparent;cursor:pointer;color:var(--danger);padding:4px 8px;border-radius:4px;flex-shrink:0}
.popup-card .popup-item .delete-btn:hover{background:#ffebee}
.popup-card .popup-footer{padding:10px 16px;text-align:center;border-top:1px solid var(--border)}
.popup-card .popup-footer button{width:100%}

/* ===== 表单 ===== */
.form-group{margin-bottom:14px}
.form-group label{display:block;font-weight:500;margin-bottom:6px;font-size:13px}
.form-group input,.form-group textarea,.form-group select{width:100%;padding:10px 14px;border:1px solid var(--border);border-radius:var(--radius);font-size:14px;outline:none;font-family:inherit;transition:border .2s}
.form-group input:focus,.form-group textarea:focus{border-color:var(--primary)}
.form-group textarea{line-height:1.6}
.form-hint{font-size:12px;color:var(--text-secondary);margin-top:4px}

/* ===== 知识库页面 ===== */
.kb-toolbar{display:flex;gap:8px;padding:12px 16px;border-bottom:1px solid var(--border);background:var(--bg-surface);flex-wrap:wrap}
.kb-grid{display:grid;gap:10px;padding:16px;overflow-y:auto;flex:1;grid-template-columns:repeat(auto-fill,minmax(220px,1fr))}
.kb-card{background:var(--bg-surface);border-radius:var(--radius);padding:14px;border:1px solid var(--border);cursor:pointer;transition:box-shadow .2s}
.kb-card:hover{box-shadow:var(--shadow)}
.kb-card .kb-name{font-weight:500;font-size:13px;margin-bottom:6px;word-break:break-all}
.kb-card .kb-meta{font-size:11px;color:var(--text-secondary)}
.kb-card .kb-actions{display:flex;gap:6px;margin-top:8px}


/* ===== 设置页面 ===== */
.settings-page{padding:32px 40px;overflow-y:auto;flex:1;width:100%;display:flex;gap:28px;flex-wrap:wrap;align-items:flex-start;scrollbar-width:none;-ms-overflow-style:none}
.settings-page::-webkit-scrollbar{display:none}
.settings-page > .settings-card:first-child{width:100%;min-width:0}
.settings-card{background:var(--bg-surface);border:1px solid var(--border);border-radius:14px;padding:32px 36px;width:100%;box-shadow:0 2px 6px rgba(0,0,0,.05);transition:box-shadow .25s,transform .2s}
.settings-card:hover{box-shadow:0 4px 16px rgba(0,0,0,.08);transform:translateY(-1px)}
.settings-card h3{margin:0 0 6px 0;font-size:20px;font-weight:600;display:flex;align-items:center;gap:10px;color:var(--text)}
.settings-card .subtitle{font-size:14px;color:var(--text-secondary);margin-bottom:22px;line-height:1.6}
.settings-card .desc{font-size:14px;color:var(--text-secondary);margin-bottom:18px;line-height:1.6}
.settings-card .form-group{margin-bottom:0}
.settings-card label{display:block;font-size:15px;font-weight:500;color:var(--text);margin-bottom:8px}
.settings-card textarea{width:100%;padding:16px 20px;border:1px solid var(--border);border-radius:10px;font-size:16px;outline:none;font-family:inherit;line-height:1.8;transition:border .25s,box-shadow .25s;resize:vertical;background:var(--card-bg);color:var(--text)}
.settings-card textarea:focus{border-color:var(--primary);box-shadow:0 0 0 4px rgba(64,150,255,.15)}
.settings-card textarea::placeholder{color:var(--text-tertiary,#bbb)}
.settings-card .actions{display:flex;gap:12px;margin-top:22px}
.settings-card .actions .btn{padding:10px 24px;font-size:15px;border-radius:8px;font-weight:500}
.settings-page .footer-info{padding:20px 28px;font-size:14px;color:var(--text-secondary);text-align:center;width:100%}
.settings-tabs{display:flex;gap:0;border-bottom:1px solid var(--border);margin-bottom:24px;padding-bottom:0}
.settings-tab{padding:12px 22px;font-size:15px;font-weight:500;border:none;background:none;cursor:pointer;color:var(--text-secondary);border-bottom:2px solid transparent;margin-bottom:-1px;transition:all .25s;border-radius:8px 8px 0 0}
.settings-tab:hover{color:var(--text);background:rgba(64,150,255,.05)}
.settings-tab.active{color:var(--primary);border-bottom-color:var(--primary);background:rgba(64,150,255,.07)}

/* 模型配置区域 */
.model-group{background:var(--bg-secondary,#f5f6f7);border-radius:12px;padding:20px 24px;margin-bottom:16px;border:1px solid var(--border);transition:border .25s,box-shadow .25s}
.model-group:hover{border-color:var(--primary-light,#b3d4ff);box-shadow:0 2px 8px rgba(64,150,255,.08)}
.model-group-label{font-size:15px;font-weight:600;color:var(--text);margin-bottom:12px;display:flex;align-items:center;gap:8px}
.model-group select{width:100%;padding:12px 16px;border:1px solid var(--border);border-radius:8px;font-size:15px;background:var(--card-bg,#fff);color:var(--text);outline:none;cursor:pointer;transition:border .2s;appearance:auto}
.model-group select:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(64,150,255,.15)}
.model-info{font-size:13px;color:var(--text-secondary);margin-top:10px;line-height:1.5;padding:8px 14px;background:rgba(64,150,255,.05);border-radius:8px;border:1px solid rgba(64,150,255,.1)}

/* 标签管理 */
.tag-chip{display:inline-flex;align-items:center;gap:4px;padding:5px 12px;background:var(--primary-light-bg,#e8f0fe);border-radius:16px;font-size:13px;color:var(--primary);margin:4px 6px 4px 0;cursor:pointer;transition:all .15s}
.tag-chip:hover{background:var(--primary);color:#fff}
.tag-chip .del{font-size:14px;cursor:pointer;opacity:.5;margin-left:2px}
.tag-chip .del:hover{opacity:1}

/* ===== 其他 ===== */
.hidden{display:none!important}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
@keyframes slideUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
.toast{position:fixed;bottom:80px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,.78);color:#fff;padding:10px 24px;border-radius:20px;font-size:13px;z-index:9999;animation:fadeIn .3s;pointer-events:none}
</style>
</head>
<body>

<div class="app">
  <!-- 顶栏 -->
  <div class="header">
    <div class="header-left">
      小赛助手 
    </div>
    <div class="header-right">
      <button class="btn-icon" id="btnFollowUp" title="跟进提醒" style="position:relative">
        🔔
        <span id="followUpBadge" style="display:none;position:absolute;top:-4px;right:-4px;background:#f44336;color:#fff;font-size:10px;min-width:16px;height:16px;border-radius:8px;line-height:16px;text-align:center;padding:0 4px;font-weight:700"></span>
      </button>
      <button class="btn-icon" id="btnKnowledge" title="知识库">📚</button>
      <button class="btn-icon" id="btnSettings" title="设置">⚙️</button>
    </div>
  </div>

  <!-- 主体 -->
  <div class="body" id="appBody">
    <!-- 侧边栏：客户列表 -->
    <div class="sidebar" id="pageCustomers">
      <div class="sidebar-search">
        <input type="text" id="customerSearch" placeholder="🔍 搜索客户...">
        <button class="add-btn" onclick="showAddCustomer()" title="新建客户">＋</button>
      </div>
      <div class="sidebar-list" id="customerList"></div>
    </div>

    <!-- 主区域 -->
    <div class="main-area" id="pageMain">
      <!-- 聊天区域（含输入框，只在此页面显示） -->
      <div class="chat-wrapper" id="chatArea">
              <div id="customerProfileInfo" style="min-height:0;transition:min-height .2s"></div>
              <div class="chat-container" id="chatContainer">
                <div class="chat-empty" id="chatEmpty">
                  <div class="icon">💬</div>
                  <div>请选择一个客户开始沟通</div>
                </div>
              </div>
              <!-- 图片预览区域（输入框上方） -->
                            <div id="imagePreviewArea"></div>
                            <!-- 标签区域（输入框上方） -->
                            <div id="tagChips" style="padding:4px 16px 0;flex-wrap:wrap;gap:6px;max-height:60px;overflow-y:auto"></div>
                            <!-- 输入区域 -->
                      <div class="chat-input-area">
                        <div id="msgInput" contenteditable="true" class="chat-input-editable" data-placeholder="输入你想说的话...（支持粘贴聊天记录）"></div>
                        <input type="file" id="customerImageInput" accept="image/*" style="display:none" onchange="uploadCustomerImage(event)" multiple>
                        <button class="img-btn" id="btnImgUpload" onclick="document.getElementById('customerImageInput').click()" title="上传图片">📷</button>
                        <button class="send-btn" id="btnSend" onclick="sendMessage()" title="发送并生成话术">➤</button>
                      </div>
      </div>

      <!-- 知识库页面（隐藏） -->
      <div class="hidden" id="pageKnowledge" style="flex:1;display:none;flex-direction:column">
        <div class="kb-toolbar">
          <button class="btn btn-primary btn-sm" onclick="uploadKnowledge()">📄 上传文档</button>
          <button class="btn btn-outline btn-sm" onclick="reindexKnowledge()">🔄 重建索引</button>
          <button class="btn btn-outline btn-sm" onclick="showPage('imageindex')" style="margin-left:auto">📷 图片索引</button>
          <input type="file" id="kbFileInput" accept=".txt,.docx,.pdf,.md" style="display:none" onchange="handleUpload(event)">
        </div>
        <div class="kb-grid" id="kbGrid"></div>
      </div>

      <!-- 图片索引卡片 -->
      <div class="hidden" id="pageImageIndex" style="display:none;flex:1;flex-direction:column;overflow:hidden;min-height:0">
        <div class="kb-toolbar">
                  <button class="btn btn-outline btn-sm" onclick="showPage('knowledge')" style="margin-right:4px">← 返回</button>
                  <button class="btn btn-primary btn-sm" onclick="imageIndexSelectFolder()">📁 选择文件夹</button>


                  <span id="imageIndexStatus" style="margin-left:auto;font-size:12px;color:var(--text-secondary)">加载中...</span>
                </div>
        
                <!-- 搜索栏 -->
                <div style="display:flex;gap:8px;padding:8px 12px;align-items:center">
                  <input id="imageSearchInput" type="text" placeholder="🔍 搜索图片关键词（如：三高、付款、女性、瘦20斤...）" style="flex:1;padding:8px 12px;border:1px solid var(--border);border-radius:8px;background:var(--input-bg);color:var(--text);outline:none" onkeydown="if(event.key==='Enter')searchImages()">
                  <button class="btn btn-outline btn-sm" onclick="searchImages()">搜索</button>
                </div>

                <div class="kb-grid" id="imageIndexGrid"></div>

                <!-- ===== 子分类详情弹窗 ===== -->
                <div id="categoryDetailModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:1000;align-items:center;justify-content:center" onclick="if(event.target===this)closeSubcategoryDetail()">
                  <div class="modal-card" style="width:90%;max-width:1000px;max-height:90vh">
                    <div class="modal-header">
                      <span id="categoryDetailTitle" style="font-size:16px;font-weight:600">📂 子分类</span>
                      <button class="modal-close-btn" onclick="closeSubcategoryDetail()">✕</button>
                    </div>
                    <div class="modal-body" id="categoryDetailBody" style="padding:16px 20px;overflow-y:auto;flex:1">

                      <!-- a) 分类描述区 -->
                      <div style="margin-bottom:14px;padding:12px;background:var(--bg-secondary);border-radius:8px;border:1px solid var(--border)">
                        <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
                          <span style="font-weight:600;font-size:13px">📝 分类描述</span>
                          <button class="btn btn-outline btn-sm" id="saveDescBtn" onclick="updateSubcategoryDesc()" style="display:none;font-size:11px">💾 保存</button>
                        </div>
                        <textarea id="categoryDescInput" style="width:100%;padding:8px 10px;border:1px solid var(--border);border-radius:6px;font-size:13px;font-family:inherit;resize:vertical;min-height:40px;background:var(--input-bg);color:var(--text);outline:none" placeholder="暂无描述，在此输入分类描述..." oninput="document.getElementById('saveDescBtn').style.display='inline-flex'"></textarea>
                      </div>

                      <!-- b) 搜索 + 排序 + 批量操作 -->
                      <div style="display:flex;gap:8px;align-items:center;margin-bottom:12px;flex-wrap:wrap">
                        <input id="subcatSearchInput" type="text" placeholder="🔍 搜索图片..." style="flex:1;min-width:120px;padding:7px 10px;border:1px solid var(--border);border-radius:6px;background:var(--input-bg);color:var(--text);font-size:13px;outline:none" onkeydown="if(event.key==='Enter')loadSubcategoryImages(window._curSubcatName,1)">
                        <select id="subcatSortSelect" style="padding:7px 10px;border:1px solid var(--border);border-radius:6px;background:var(--input-bg);color:var(--text);font-size:13px;outline:none" onchange="loadSubcategoryImages(window._curSubcatName,1)">
                          <option value="created_at">按添加时间</option>
                          <option value="use_count">按使用次数</option>
                        </select>
                        <select id="batchActionSelect" style="padding:7px 10px;border:1px solid var(--border);border-radius:6px;background:var(--input-bg);color:var(--text);font-size:13px;outline:none">
                          <option value="">批量操作...</option>
                          <option value="delete">🗑 批量删除</option>
                          <option value="tag">🏷 批量标签</option>
                        </select>
                        <button class="btn btn-primary btn-sm" onclick="executeBatchAction()">执行</button>
                      </div>

                      <!-- 图片表格头部信息 -->
                      <div id="subcatImageInfo" style="font-size:12px;color:var(--text-secondary);margin-bottom:8px"></div>

                      <!-- c) 图片表格 -->
                      <div id="subcatImageList" style="min-height:100px"></div>

                      <!-- 分页 -->
                      <div id="subcatPagination" style="display:flex;justify-content:center;gap:6px;margin-top:12px;flex-wrap:wrap"></div>

                    </div>
                    <!-- 底部按钮 -->
                    <div class="modal-footer">
                      <div style="position:relative;display:inline-block">
                        <button class="btn btn-outline btn-sm" id="addImageBtn" onclick="toggleAddImageOptions()">➕ 添加图片</button>
                        <div id="addImageOptions" style="display:none;position:absolute;bottom:100%;left:0;background:var(--bg-surface);border:1px solid var(--border);border-radius:8px;box-shadow:0 4px 16px rgba(0,0,0,0.12);padding:6px;z-index:10;min-width:180px">
                          <div style="padding:8px 12px;cursor:pointer;border-radius:6px;font-size:13px" onmouseover="this.style.background='var(--bg-secondary)'" onmouseout="this.style.background=''" onclick="uploadLocalImages(window._curSubcatName)">📤 从本地上传</div>
                          <div style="padding:8px 12px;cursor:pointer;border-radius:6px;font-size:13px" onmouseover="this.style.background='var(--bg-secondary)'" onmouseout="this.style.background=''" onclick="copyFromOtherCategory(window._curSubcatName)">📋 从其他分类复制</div>
                        </div>
                      </div>
                      <button class="btn btn-outline btn-sm" onclick="closeSubcategoryDetail()">✕ 关闭</button>
                    </div>
                  </div>
                </div>

                <!-- ===== 图片编辑弹窗 ===== -->
                <div id="editorModal" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:1100;align-items:center;justify-content:center" onclick="if(event.target===this)closeEditorModal()">
                  <div class="modal-card" style="width:520px;max-height:90vh">
                    <div class="modal-header">
                      <span style="font-size:16px;font-weight:600">✏️ 编辑图片</span>
                      <button class="modal-close-btn" onclick="closeEditorModal()">✕</button>
                    </div>
                    <div class="modal-body" style="padding:16px 20px;overflow-y:auto;flex:1">
                      <!-- 缩略图 -->
                      <div id="editorThumbArea" style="text-align:center;margin-bottom:14px">
                        <img id="editorThumb" src="" style="max-width:100%;max-height:180px;border-radius:8px;border:1px solid var(--border);cursor:pointer" onclick="openImagePreview(this.src)">
                      </div>
                      <!-- 表单 -->
                      <div class="form-group">
                        <label>ID</label>
                        <input id="editorId" type="text" readonly style="width:100%;padding:8px 12px;border:1px solid var(--border);border-radius:6px;background:var(--bg-secondary);color:var(--text-secondary);font-size:13px">
                      </div>
                      <div class="form-group">
                        <label>文件路径</label>
                        <input id="editorPath" type="text" readonly style="width:100%;padding:8px 12px;border:1px solid var(--border);border-radius:6px;background:var(--bg-secondary);color:var(--text-secondary);font-size:13px">
                      </div>
                      <div class="form-group">
                        <label>描述</label>
                        <textarea id="editorDesc" rows="3" style="width:100%;padding:8px 12px;border:1px solid var(--border);border-radius:6px;font-size:13px;font-family:inherit;resize:vertical;outline:none;background:var(--input-bg);color:var(--text)"></textarea>
                      </div>
                      <div class="form-group">
                        <label>标签（逗号分隔）</label>
                        <input id="editorTags" type="text" style="width:100%;padding:8px 12px;border:1px solid var(--border);border-radius:6px;font-size:13px;outline:none;background:var(--input-bg);color:var(--text)">
                      </div>
                      <div class="form-group">
                        <label>适用客户</label>
                        <textarea id="editorCustomers" rows="2" style="width:100%;padding:8px 12px;border:1px solid var(--border);border-radius:6px;font-size:13px;font-family:inherit;resize:vertical;outline:none;background:var(--input-bg);color:var(--text)"></textarea>
                      </div>
                      <div class="form-group">
                        <label>案例组ID</label>
                        <input id="editorCaseGroup" type="text" style="width:100%;padding:8px 12px;border:1px solid var(--border);border-radius:6px;font-size:13px;outline:none;background:var(--input-bg);color:var(--text)" placeholder="数字序号">
                      </div>
                      <div class="form-group">
                        <label>备注</label>
                        <textarea id="editorRemark" rows="2" style="width:100%;padding:8px 12px;border:1px solid var(--border);border-radius:6px;font-size:13px;font-family:inherit;resize:vertical;outline:none;background:var(--input-bg);color:var(--text)"></textarea>
                      </div>
                      <div class="form-group">
                        <label>使用次数（只读）</label>
                        <input id="editorUseCount" type="text" readonly style="width:100%;padding:8px 12px;border:1px solid var(--border);border-radius:6px;background:var(--bg-secondary);color:var(--text-secondary);font-size:13px">
                      </div>
                    </div>
                    <div class="modal-footer">
                      <button class="btn btn-outline" onclick="closeEditorModal()">取消</button>
                      <button class="btn btn-primary" id="editorSaveBtn" onclick="saveImageEdit()">💾 保存</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>

              <!-- 设置页面（隐藏） -->
      <div class="hidden settings-page" id="pageSettings" style="display:none">
              <div class="settings-card">
                <div class="settings-tabs">
                                  <button class="settings-tab active" data-tab="tabSystemPrompt" onclick="switchSettingsTab('tabSystemPrompt')">🎯 话术提示词</button>
                                  <button class="settings-tab" data-tab="tabImageGen" onclick="showToast('⏳ 等待开发')">🖼️ 图片生成</button>
                                  <button class="settings-tab" data-tab="tabImageRec" onclick="switchSettingsTab('tabImageRec')">👁️ 图片识别</button>
                                  <button class="settings-tab" data-tab="tabImageRecIndex" onclick="switchSettingsTab('tabImageRecIndex')">🔍 索引识别</button>
                                  <button class="settings-tab" data-tab="tabModelConfig" onclick="switchSettingsTab('tabModelConfig');setTimeout(loadModelConfigTab,0)">🤖 模型配置</button>
                                </div>
                <div id="tabSystemPrompt" class="settings-tab-content">
                  <div class="subtitle">这个提示词告诉AI怎么说话、怎么推单、怎么处理各种客户情况。修改后点击保存即时生效。</div>
                  <textarea id="cfgPrompt" rows="18"></textarea>
                  <div class="actions">
                    <button class="btn btn-primary" onclick="savePrompt()">💾 保存提示词</button>
                    <button class="btn btn-outline" onclick="loadPrompt()">🔄 恢复默认</button>
                  </div>
                </div>
                <div id="tabImageGen" class="settings-tab-content" style="display:none">
                  <div class="subtitle">AI生成图片时使用的提示词模板。<code>{description}</code> 会被替换为实际图片描述。此功能等待开发中。</div>
                                      <textarea id="cfgImageGenPrompt" rows="12" readonly style="background:#f5f5f5;cursor:not-allowed"></textarea>
                                      <div class="actions">
                                        <button class="btn btn-outline" onclick="showToast('⏳ 等待开发')">⏳ 等待开发</button>
                                      </div>
                                  </div>
                                  <div id="tabImageRec" class="settings-tab-content" style="display:none">
                                    <div class="subtitle">AI识别客户上传的图片（排油图、排便图等）时使用的提示词。修改后点击保存即时生效。</div>
                                    <textarea id="cfgImageRecPrompt" rows="18"></textarea>
                                    <div class="actions">
                                      <button class="btn btn-primary" onclick="savePromptByName('image_recognition_chat')">💾 保存图片识别提示词</button>
                                      <button class="btn btn-outline" onclick="loadAllPrompts()">🔄 刷新</button>
                                    </div>
                                    <div style="margin-top:20px;padding-top:20px;border-top:1px solid var(--border)">
                                      <div class="subtitle">为图片库中所有已描述的图片生成向量索引，实现语义搜索（输入"排油很多"能搜到相关图片）。首次使用图片搜索前需要执行一次。</div>
                                      <button class="btn btn-outline" onclick="reindexImageVectors()">🔧 重建向量索引</button>
                                      <span id="reindexStatus" style="margin-left:8px;font-size:12px;color:#999"></span>
                                    </div>
                                  </div>
                                  <div id="tabImageRecIndex" class="settings-tab-content" style="display:none">
                                    <div class="subtitle">AI识别图片库中的图片（用于构建图片索引描述）时使用的提示词。修改后点击保存即时生效。</div>
                                    <textarea id="cfgImageRecIndexPrompt" rows="18"></textarea>
                                    <div class="actions">
                                      <button class="btn btn-primary" onclick="savePromptByName('image_recognition_index')">💾 保存索引识别提示词</button>
                                      <button class="btn btn-outline" onclick="loadAllPrompts()">🔄 刷新</button>
                                    </div>
                                  </div>
                                                    <div id="tabModelConfig" class="settings-tab-content" style="display:none">
                                                                      <div class="subtitle">选择不同用途使用的模型。所有模型从同一个模型池中选取，可点击下方按钮管理模型列表。</div>
                                                                      <div style="padding:8px 12px;border-radius:6px;background:var(--bg-secondary);margin-bottom:12px;font-size:13px;display:flex;align-items:center;gap:8px">
                                                                        <span>API状态：</span>
                                                                        <span id="apiStatusIndicator" class="api-status-unknown" style="font-weight:600">检测中...</span>
                                                                        <button class="btn btn-xs btn-outline" onclick="checkApiExpiry()" style="font-size:11px">🔄 刷新</button>
                                                                      </div>
                                                                      <div class="model-group">
                                                                        <div class="model-group-label">💬 话术生成模型</div>
                                                                        <select id="selChatModel" onchange="onChangeModelType('chat')"></select>
                                                                        <div id="chatModelInfo" class="model-info"></div>
                                                                      </div>
                                                                      <div class="model-group">
                                                                        <div class="model-group-label">🖼️ 图片生成模型</div>
                                                                        <select id="selImageGenModel" onchange="onChangeModelType('imagegen')"></select>
                                                                        <div id="imagegenModelInfo" class="model-info"></div>
                                                                      </div>
                                                                      <div class="model-group">
                                                                        <div class="model-group-label">👁️ 图片识别模型</div>
                                                                        <select id="selVisionModel" onchange="onChangeModelType('vision')"></select>
                                                                        <div id="visionModelInfo" class="model-info"></div>
                                                                      </div>
                                                                      <div class="model-group">
                                                                        <div class="model-group-label">🧬 向量模型</div>
                                                                        <select id="selEmbeddingModel" onchange="onChangeModelType('embedding')"></select>
                                                                        <div id="embeddingModelInfo" class="model-info"></div>
                                                                      </div>
                                                                      <div class="actions" style="margin-top:20px">
                                                                        <button class="btn btn-outline" onclick="toggleModelPopup()">📋 管理模型</button>
                                                                        <span id="modelConfigStatus" style="font-size:12px;color:var(--text-secondary);margin-left:8px"></span>
                                                                      </div>
                                                                    </div>
              </div>

        <div class="settings-card">
          <h3>🚫 违禁词</h3>
          <div class="desc">生成话术时禁止出现的词。每行写一个，保存后生成话术会自动将违禁词替换为合规说法（不再显示 **）。</div>
          <textarea id="cfgBannedWords" rows="12"></textarea>
          <div class="actions">
            <button class="btn btn-primary" onclick="saveBannedWords()">💾 保存违禁词</button>
          </div>
        </div>

        <!-- 标签管理 -->
        <div class="settings-card">
          <h3>🏷️ 分析标签</h3>
