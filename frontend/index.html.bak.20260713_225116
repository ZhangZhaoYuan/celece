async function removeModel(modelId) {
  if (!(await showConfirm('确定删除此模型？'))) return;
  try {
    await api('DELETE', `/api/models/${modelId}`);
    showToast('已删除');
    // 刷新模型信息
    await loadModelInfo();
    renderModelList();
    // 刷新设置页的下拉框（如果设置页是打开的）
    try { loadModelConfigTab(); } catch(e) {}
    // 检查被删除的模型是否曾是默认，如果是则自动选下一个
    // 从最新列表中找到各分类的第一个模型作为新的默认
    _defaultIds = _defaultIds || { chat: '', vision: '', imagegen: '', embedding: '' };
    const currDefaultIds = { ..._defaultIds };
    const catKeys = ['chat', 'vision', 'imagegen', 'embedding'];
    const labelMap = { chat: '话术生成', vision: '图片识别', imagegen: '图片生成', embedding: '向量' };
    const suffixMap = { chat: '/default', vision: '/vision-default', imagegen: '/image-gen-default', embedding: '/embedding-default' };
    for (const key of catKeys) {
      if (modelId === currDefaultIds[key]) {
        // 被删的是默认模型，找下一个同分类的模型
        const models = _modelList || allModels;
        // 用 getCat 判断分类（复用的函数在 renderModelList 里）
        const next = models.find(m => {
          if (m.id === modelId) return false;
          const cats = m.categories || [];
          if (cats.includes(key)) return true;
          // fallback 判断
          if (m.id === _defaultIds.vision) return key === 'vision';
          if (m.id === _defaultIds.imagegen) return key === 'imagegen';
          if (m.id === _defaultIds.embedding) return key === 'embedding';
          const n = (m.model || '').toLowerCase(), id = (m.id || '').toLowerCase();
          if (key === 'embedding' && (n.includes('embedding') || id.includes('embedding'))) return true;
          if (key === 'vision' && (n.includes('v-flash') || n.includes('4v') || n.includes('vision') || n.includes('omni-turbo'))) return true;
          if (key === 'imagegen' && (n.includes('cogview') || n.includes('image') || id.includes('image_gen') || id.includes('imagegen'))) return true;
          return key === 'chat';
        });
        if (next) {
          try {
            await api('PUT', '/api/models/' + next.id + suffixMap[key]);
            showToast('已自动切换' + labelMap[key] + '默认模型到 ' + next.model);
          } catch(e) {}
        }
      }
    }
    // 再次刷新
    await loadModelInfo();
    renderModelList();
    try { loadModelConfigTab(); } catch(e) {}
  } catch(e) { showToast('删除失败: '+e.message); }
}
