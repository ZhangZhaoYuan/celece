async function imageIndexSelectFolder() {
  const input = document.createElement('input');
  input.type = 'file';
  input.webkitdirectory = true;
  input.multiple = true;
  input.onchange = async () => {
      const files = Array.from(input.files || []);
      if (!files.length) return;
      // 判断图片是直接放在选中文件夹里，还是在子文件夹中
      const hasSubfolders = files.some(f => (f.webkitRelativePath || '').indexOf('/') !== -1);
      if (hasSubfolders) {
        // 情况1：选中的文件夹里有子文件夹 → 子文件夹名作为分类名
        const folders = {};
        for (const f of files) {
          const rel = f.webkitRelativePath || f.name;
          const top = rel.split('/')[0];
          if (!top) continue;
          if (!folders[top]) folders[top] = [];
          folders[top].push(f);
        }
        const folderNames = Object.keys(folders);
        if (!folderNames.length) { showToast('❌ 未选择有效文件夹'); return; }
        let pathHint = 'C:\\Users\\zhang\\Desktop\\' + folderNames[0];
        const folderPath = await showPrompt('请输入文件夹的完整路径：\n（子文件夹名将自动作为子分类）', pathHint, '选择文件夹');
        if (!folderPath || !folderPath.trim()) { showToast('❌ 已取消'); return; }
        const basePath = folderPath.trim().replace(/\\/g, '/').replace(/\/+$/, '');
        showToast('⏳ 正在处理 ' + folderNames.length + ' 个文件夹...');
        try {
          let totalNew = 0;
          for (const name of folderNames) {
            const fullPath = basePath + '/' + name;
            const r = await api('POST', '/api/image-index/scan-incremental', { path: fullPath, category_name: name });
